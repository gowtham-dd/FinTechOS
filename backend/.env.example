# Quant & FinTech Agent OS - Backend Environment Template

# Featherless LLM Inference API Key
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_MODEL=unsloth/Llama-3.3-70B-Instruct
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# MongoDB Atlas Cloud Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fintech_agent_os?retryWrites=true&w=majority
MONGODB_DB_NAME=fintech_agent_os

# JWT Authentication
JWT_SECRET_KEY=fintech_os_super_secret_jwt_key_2026_key_99812
JWT_ALGORITHM=HS256

# Security & CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
